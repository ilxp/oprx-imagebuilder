# ==============================================================================
# x86_64 目标 —— 标准软路由 / 工控机 / 虚拟机
# 由 build.sh 以 `. config/targets/x86_64.conf` 加载
# 覆盖优先级：本文件 > config/build.conf（同名变量会被覆盖）
#
# ⚠️ PACKAGES_ARCH_EXTRA 里**只能放包名**，不能有中文 / `#` 注释 / 空行之外的
#    任何非包名字符 —— 会被 shell 词分割后当成"包名"传给 make image，
#    导致 `no such package` 剔除。
# ==============================================================================

# ---- 自声明（防止复制错文件） ----
CONF_TARGET="x86_64"

# ---- OpenWrt target 三元组 ----
TARGET="x86"
SUBTARGET="64"
ARCH_PACKAGES="x86_64"

# ---- ImageBuilder 归档名 ----
# 完整名：openwrt-imagebuilder-<ver>-<IB_ARCH_TAG>.<IB_HOST_TAG>.tar.zst
IB_ARCH_TAG="x86-64"
IB_HOST_TAG="Linux-x86_64"

# ---- Profile ----
PROFILE="generic"

# ---- 镜像规格 ----
# ROOTFS_SIZE_MB 是根分区大小（MiB）；EXTRA_IMAGE_NAME 只影响文件名后缀
# 为了文件名和实际大小一致，900 MiB 用 "900m"（不是 "1g"）
ROOTFS_SIZE_MB="900"                        # 900 MiB
EXTRA_IMAGE_NAME="900m"                     # 只影响文件名

# ---- 发布变体（会被 build.conf 的 GENERATE_* 覆盖，仅作兜底）----
RELEASE_VARIANT="squashfs-combined-efi"
VARIANT_DESC="squashfs + EFI 引导整盘镜像"

# ---- 架构专属开关 ----
ENABLE_INTEL_PSTATE="true"
CPU_GOVERNOR="powersave"

# ---- 架构专属预装包 ----
# 分类参考（仅作说明，不写进变量）：
#   网卡：e1000 / e1000e / igb / igc / i40e / ixgbe / r8169 / tg3 / bnx2 / ...
#   显卡：drm / drm-i915 / drm-amdgpu / drm-radeon / fb / backlight
#   声卡：sound-hda-intel / sound-hda-codec-realtek
#   摄像：video-uvc / video-pwc / video-videobuf2
#   其他：button-hotplug / grub2-bios-setup
PACKAGES_ARCH_EXTRA="
kmod-e1000
kmod-e1000e
kmod-igb
kmod-igbvf
kmod-igc
kmod-i40e
kmod-iavf
kmod-ixgbe
kmod-ixgbevf
kmod-r8169
kmod-tg3
kmod-bnx2
kmod-bnx2x
kmod-atlantic
kmod-mlxfw
kmod-amazon-ena
kmod-amd-xgbe
kmod-dwmac-intel
kmod-forcedeth
kmod-drm
kmod-drm-ttm
kmod-drm-kms-helper
kmod-drm-i915
kmod-drm-amdgpu
kmod-drm-radeon
kmod-backlight
kmod-sound-hda-intel
kmod-sound-hda-codec-realtek
kmod-video-uvc
kmod-video-pwc
kmod-video-videobuf2
kmod-button-hotplug
grub2-bios-setup
"
